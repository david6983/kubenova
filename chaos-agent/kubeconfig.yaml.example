# Copy this file to kubeconfig.yaml and fill in your cluster details.
# kubeconfig.yaml is gitignored — never commit real credentials.
#
# For a KinD cluster, export your config with:
#   kind get kubeconfig --name <cluster-name> > chaos-agent/kubeconfig.yaml

apiVersion: v1
clusters:
- cluster:
    server: https://<your-cluster-api-server>
    # For local dev clusters only — do not use in production:
    # insecure-skip-tls-verify: true
    # Or provide a CA cert:
    # certificate-authority-data: <base64-encoded-ca-cert>
  name: <cluster-name>
contexts:
- context:
    cluster: <cluster-name>
    user: <cluster-name>
  name: <cluster-name>
current-context: <cluster-name>
kind: Config
preferences: {}
users:
- name: <cluster-name>
  user:
    client-certificate-data: <base64-encoded-client-cert>
    client-key-data: <base64-encoded-client-key>
