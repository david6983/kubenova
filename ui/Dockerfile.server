FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293

ARG TARGETARCH=amd64
ARG KUBECTL_VERSION=v1.30.0

# Install kubectl, then drop curl immediately
RUN apk add --no-cache curl && \
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      -o /usr/local/bin/kubectl && \
    chmod +x /usr/local/bin/kubectl && \
    apk del curl

# Non-root user
RUN addgroup -S kubenova && adduser -S -G kubenova kubenova

RUN corepack enable && corepack prepare pnpm@10.2.1 --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY ui/package.json ./ui/package.json
COPY chaos-agent/package.json ./chaos-agent/package.json
RUN pnpm install --frozen-lockfile --filter ui --prod

COPY --chown=kubenova:kubenova ui/server.js ./ui/server.js
RUN chown -R kubenova:kubenova /app

WORKDIR /app/ui

ENV KUBENOVA_CONTEXT=""
ENV NODE_ENV=production

USER kubenova
EXPOSE 3001

CMD ["node", "--disable-proto=delete", "server.js"]
