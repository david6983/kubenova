FROM node:20-alpine

# kubectl — arch-aware via Docker buildx TARGETARCH (amd64 or arm64)
ARG TARGETARCH=amd64
ARG KUBECTL_VERSION=v1.30.0

RUN apk add --no-cache curl && \
    curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
      -o /usr/local/bin/kubectl && \
    chmod +x /usr/local/bin/kubectl && \
    apk del curl

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.js ./

# KUBEBOAT_CONTEXT: set to a kubeconfig context name for local use,
# or leave empty to use in-cluster service account auth (default in k8s).
ENV KUBEBOAT_CONTEXT=""

EXPOSE 3001
CMD ["node", "server.js"]
